{
  "name": "@coryrylan/cradle-monorepo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "projects/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "@eslint/js": "10.0.1",
      "eslint": "10.9.1",
      "typescript": "6.0.3",
      "typescript-eslint": "8.68.0"
    }
  },
  "scripts": {
    "ci": "wireit",
    "ci:nocache": "bun run clean && bun i --frozen-lockfile && bun run ci",
    "format": "wireit",
    "format:fix": "wireit",
    "lint:knip": "wireit",
    "release": "wireit",
    "clean": "git clean -dfX",
    "prepare": "husky"
  },
  "wireit": {
    "ci": {
      "dependencies": [
        "format",
        "lint:knip",
        "./projects/cli:ci",
        "./projects/docs:ci"
      ]
    },
    "format": {
      "command": "prettier --config=prettier.config.js --check --cache .",
      "files": [
        "projects/**/*.ts",
        "projects/**/*.json",
        "projects/**/*.md",
        "*.md",
        "!**/.wireit/**",
        "!**/dist/**"
      ],
      "output": [
        "node_modules/.cache/prettier/**"
      ]
    },
    "format:fix": {
      "command": "prettier --config=prettier.config.js --write ."
    },
    "lint:knip": {
      "command": "knip --no-progress",
      "files": [
        "projects/**/*.ts",
        "projects/**/package.json",
        "projects/**/tsconfig*.json",
        "projects/**/eslint.config.js",
        "knip.config.js",
        "package.json",
        "release.config.js",
        "commitlint.config.js",
        "!projects/**/dist/**",
        "!projects/**/.wireit/**",
        "!projects/**/node_modules/**"
      ],
      "output": []
    },
    "release": {
      "command": "cd projects/cli && HUSKY=0 bun x semantic-release"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@nvidia-elements/code": "2.0.4",
    "@nvidia-elements/core": "2.6.0",
    "@nvidia-elements/styles": "2.1.3",
    "@nvidia-elements/themes": "2.0.1",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "husky": "9.1.7",
    "knip": "6.33.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "wireit": "0.14.13"
  }
}
